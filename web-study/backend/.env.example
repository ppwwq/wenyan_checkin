# Node 24.16+; copy locally and use a process manager to inject these values.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./web-study/backend/data/study.sqlite
# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOTSTRAP_INVITE=replace-with-random-student-invitation
ADMIN_USERNAME=teacher
ADMIN_INVITE=replace-with-another-random-single-use-invitation
# HTTPS origin in production; omit for same-origin local HTTP testing.
# PUBLIC_ORIGIN=https://study.example.com
