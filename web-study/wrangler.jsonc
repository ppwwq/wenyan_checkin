{
  "name": "chinese-a-study",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/content/sources/revision-book.pdf"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STUDY_DATABASE",
        "class_name": "StudyDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "StudyDatabase"
      ]
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "teacher"
  },
  "account_id": "86eac8fedb92cf5e11c160669b5605b7"
}
